# ============================================================
# recordya-chat — unified configuration
# Copy to .env and fill in your values:  cp .env.example .env
# ============================================================

# === Database (PostgreSQL) ===
POSTGRES_USER=recordyachat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app_db

# === Database URL — MANUAL (non-Docker) runs ONLY ===
# Under Docker Compose this value is IGNORED: the backend URL is built
# automatically from the POSTGRES_* variables above (host: "postgres").
# Set this only when running the backend directly on the host (uvicorn),
# pointing at a locally reachable PostgreSQL (host: "localhost").
APP_DATABASE_URL=postgresql+asyncpg://recordyachat:change-me@localhost:5432/app_db

# === Backend (FastAPI) ===
SECRET_KEY=change-me-in-production-minimum-32-characters-long

# === LLM ===
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_MODEL=gpt-5.2

# Alternative: Fireworks AI
# OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1
# OPENAI_API_KEY=fw_your-fireworks-key
# DEFAULT_LLM_MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct

# === CORS ===
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# === Server ===
HOST=0.0.0.0
PORT=8000
DEBUG=true
ENV=local

# === Localization ===
# Static, config-driven UI language for frontend, backend messages and Keycloak.
# Allowed: en | pl. Unset or unknown values fall back to en. No runtime switching.
DEFAULT_LOCALE=en

# === Frontend ===
# The frontend reads its API URL at runtime from public/config/config.json
# (key: "apiUrl"). No build-time env var is required here.

# === Keycloak (SSO) ===
AUTH_MODE=keycloak
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_FRONTEND_URL=http://localhost:8180
KEYCLOAK_REALM=recordya
KEYCLOAK_CLIENT_ID=recordya-chat
KEYCLOAK_CLIENT_NAME=Recordya Chat
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak theme (local dev only — docker-compose volume mount)
# Default: core recordya theme
KEYCLOAK_THEME_DIR=./keycloak/themes/recordya
KEYCLOAK_THEME_NAME=recordya

# === Langfuse (optional — LLM observability) ===
LANGFUSE_ENABLED=false
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# === Email (optional) ===
# Read by send_email() / SmtpConfig.from_env(). If SMTP_HOST or SMTP_FROM
# are unset, send_email() returns False and logs a warning (no exception).
# Local dev: point at MailPit (brew install mailpit && mailpit), no auth, no TLS.
# Production: corporate SMTP relay with auth + STARTTLS.
# See: docs/services/email.md
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=false
# SMTP_FROM=Recordya Monitoring <noreply@example.com>
